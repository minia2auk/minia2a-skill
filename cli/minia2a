#!/usr/bin/env node
// minia2a CLI — x402 agent marketplace client (V5)
// Usage: minia2a <command> [options]
// API base: MINIA2A_API env var (default https://minia2a.uk)
// Zero dependencies — runs on any Node 18+ installation.

const API = process.env.MINIA2A_API || 'https://minia2a.uk';
const USAGE = `
minia2a — x402 agent marketplace (V5)

Usage:
  minia2a discover [query] [--category <cat>] [--sort volume|price]
  minia2a meta
  minia2a register --name <n> --wallet <0x...> --signature <0x...>
  minia2a publish --name <n> --endpoint <url> --price <cents> --description <text>
                  [--category <cat>] --wallet <0x...> --signature <0x...>
  minia2a call <service-id> --wallet <0x...> [--signature <0x...> --timestamp <unix>]
                            [--input <json>] [--probe]
  minia2a help [topic]

No human signup. Sign with a self-custody wallet + EIP-191 signature for
5 free trial calls (no registration). Pay per call in USDC via x402
(HTTP 402) once trials run out. Full guide: https://minia2a.uk/AGENTS.md
`;

function bail(msg, code = 1) {
  console.error(msg);
  process.exit(code);
}

function json(data) {
  console.log(JSON.stringify(data));
}

// ----- agent identity -----
// Sent on first-party requests so the gateway can count distinct agents; the
// server stores only HMAC(secret, id), never the raw value. Identity is
// per-machine, not per-process — a per-process id would count every invocation
// as a new agent and inflate the adoption metric it feeds.
const os = require('os');
const fs = require('fs');
const path = require('path');
let _agentIdResolved = false;
let _agentIdCache = null;

function agentId() {
  if (_agentIdResolved) return _agentIdCache;
  _agentIdResolved = true;
  const fromEnv = process.env.MINIA2A_AGENT_ID;
  if (fromEnv) return (_agentIdCache = fromEnv);
  // Two locations exist across our published clients: the `minia2a` package reads
  // ~/.minia2a-agent-id (the path the gateway's adoption.go names) and
  // `minia2a-cli` reads ~/.minia2a/agent-id. Read both, in that order, so a
  // machine that already has an id from either client keeps one identity instead
  // of being counted twice; create the gateway-documented one.
  const candidates = [
    path.join(os.homedir(), '.minia2a-agent-id'),
    path.join(os.homedir(), '.minia2a', 'agent-id'),
  ];
  for (const file of candidates) {
    try {
      const existing = fs.readFileSync(file, 'utf8').trim();
      if (existing) return (_agentIdCache = existing);
    } catch (e) { /* not created yet — fall through to the next candidate */ }
  }
  const id = 'agent:' + require('crypto').randomUUID();
  try {
    fs.writeFileSync(candidates[0], id, { mode: 0o600 });
    return (_agentIdCache = id);
  } catch (e) {
    return (_agentIdCache = null);
  }
}

// The id identifies us to our own gateway. A catalog entry can point off-domain
// (the external-api category), so the header is gated on the host: a stable
// per-machine identifier must not travel to a third party.
function isFirstParty(url) {
  try {
    const h = new URL(url).hostname;
    return h === 'minia2a.uk' || h.endsWith('.minia2a.uk');
  } catch (e) {
    return false;
  }
}

function identityHeaders(url) {
  const id = isFirstParty(url) ? agentId() : null;
  return id ? { 'X-Agent-ID': id } : {};
}

function apiHeaders(url, extra) {
  return { ...identityHeaders(url), ...(extra || {}) };
}

// ----- argument parsing -----
const argv = process.argv.slice(2);
const cmd = argv[0];
const args = argv.slice(1);

function flag(name) {
  const i = args.indexOf('--' + name);
  if (i === -1) return null;
  const v = args[i + 1];
  return (!v || v.startsWith('--')) ? true : v;
}

const positional = [];
for (let i = 0; i < args.length; i++) {
  if (args[i].startsWith('--')) { i++; continue; }
  positional.push(args[i]);
}

// ----- commands -----
async function discover() {
  const query = positional[0] || '';
  const category = flag('category') || '';
  const sort = flag('sort') || '';
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  if (sort) params.set('sort', sort);
  try {
    const r = await fetch(`${API}/api/services?${params}`, { headers: apiHeaders(`${API}/api/services`) });
    const d = await r.json();
    json(d);
    if (!r.ok) process.exit(3);
  } catch (e) {
    bail(`Cannot reach marketplace: ${e.message}`, 3);
  }
}

async function meta() {
  try {
    const r = await fetch(`${API}/.well-known/x402`, { headers: apiHeaders(`${API}/.well-known/x402`) });
    const d = await r.json();
    json(d);
    if (!r.ok) process.exit(3);
  } catch (e) {
    bail(`Cannot reach marketplace: ${e.message}`, 3);
  }
}

async function register() {
  const name = flag('name');
  const wallet = flag('wallet');
  const signature = flag('signature');

  if (!name || name === true) bail('--name <name> required');
  if (!wallet || wallet === true) bail('--wallet <0x...> required (your own self-custody wallet)');

  if (!signature || signature === true) {
    // The CLI never holds your key — you sign the message yourself (EIP-191 personal_sign).
    console.error('A signature is required. Sign this exact message with your wallet (EIP-191 personal_sign):\n');
    console.error(`  minia2a register: ${wallet}\n`);
    console.error('Then re-run with --signature <0x...>:\n');
    console.error(`  minia2a register --name "${name}" --wallet "${wallet}" --signature "0xYOUR_SIGNATURE"\n`);
    console.error('(cast example: cast wallet sign --data 0x... "minia2a register: <wallet>")');
    process.exit(1);
  }

  const body = { name, wallet, signature };
  try {
    const r = await fetch(`${API}/api/v1/register-simple`, {
      method: 'POST',
      headers: apiHeaders(`${API}/api/v1/register-simple`, { 'Content-Type': 'application/json' }),
      body: JSON.stringify(body)
    });
    const d = await r.json();
    json(d);
    if (!r.ok) process.exit(3);
  } catch (e) {
    bail(`Cannot reach marketplace: ${e.message}`, 3);
  }
}

// Seller path. `register` above proves wallet ownership (BUYER-side, not a listing) —
// publishing a service is a different endpoint with a different signed message.
const CATEGORIES = ['tools', 'premium', 'defi', 'data'];

async function publish() {
  const name = flag('name');
  const endpoint = flag('endpoint');
  const price = flag('price');
  const wallet = flag('wallet');
  const signature = flag('signature');
  let category = flag('category');

  if (!name || name === true) bail('--name <name> required');
  if (!endpoint || endpoint === true) bail('--endpoint <https://...> required');
  if (!wallet || wallet === true) bail('--wallet <0x...> required (revenue settles here)');

  if (!/^https?:\/\//i.test(endpoint)) bail('--endpoint must be an absolute http(s) URL');

  // Rejected server-side anyway (SSRF guard) — fail early with a clearer reason.
  if (/^https?:\/\/(localhost|127\.|10\.|192\.168\.|169\.254\.|\[::1\])/i.test(endpoint)) {
    bail('--endpoint must be publicly reachable; internal/loopback addresses are rejected');
  }

  const priceCents = Number(price);
  if (!Number.isInteger(priceCents) || priceCents < 1 || priceCents > 10000) {
    bail('--price <cents> required: integer 1–10000 (1 = $0.01, 10000 = $100.00)');
  }

  // Server enforces a 20-char minimum; catch it here so the failure is legible.
  const description = flag('description');
  if (!description || description === true || String(description).length < 20) {
    bail('--description <text> required: at least 20 characters (buyers see this in the catalog)');
  }

  if (!category || category === true) category = 'tools';
  if (!CATEGORIES.includes(category)) {
    bail(`--category must be one of: ${CATEGORIES.join(', ')}`);
  }

  if (!signature || signature === true) {
    // Same contract as register: the CLI never holds your key.
    console.error('A signature is required. Sign this exact message with your wallet (EIP-191 personal_sign):\n');
    console.error(`  minia2a publish: ${wallet}\n`);
    console.error('Then re-run with --signature <0x...>:\n');
    console.error(`  minia2a publish --name "${name}" --endpoint "${endpoint}" --price ${priceCents} --wallet "${wallet}" --signature "0xYOUR_SIGNATURE"\n`);
    console.error('(cast example: cast wallet sign --data 0x... "minia2a publish: <wallet>")');
    process.exit(1);
  }

  const body = { name, endpoint, price_cents: priceCents, category, description, wallet, signature };
  try {
    const r = await fetch(`${API}/api/v1/publish-service`, {
      method: 'POST',
      headers: apiHeaders(`${API}/api/v1/publish-service`, { 'Content-Type': 'application/json' }),
      body: JSON.stringify(body)
    });
    const d = await r.json();
    json(d);
    if (!r.ok) process.exit(3);
    // The catalog does not round-trip an HTTP method yet, so POST-only endpoints
    // get called with GET by generic clients. Warn rather than let it fail silently.
    console.error('\nPublished. Note: the catalog does not yet record an HTTP method —');
    console.error('callers default to GET. If your endpoint requires POST, state that in');
    console.error('the service description until method round-trip ships.');
  } catch (e) {
    bail(`Cannot reach marketplace: ${e.message}`, 3);
  }
}

async function call(id) {
  if (!id) bail('Usage: minia2a call <service-id> --wallet <0x...> [--input <json>] [--probe]');
  const wallet = flag('wallet');
  const probe = flag('probe') === true; // --probe present → just check price, no credits consumed
  let input = undefined;
  const inputStr = flag('input');
  if (inputStr && inputStr !== true) {
    try { input = JSON.parse(inputStr); } catch { bail('--input must be valid JSON'); }
  }

  // Resolve the service endpoint
  let svc;
  try {
    const r = await fetch(`${API}/api/services/${encodeURIComponent(id)}`, { headers: apiHeaders(`${API}/api/services`) });
    if (!r.ok) bail(`Service not found: ${id}`, 3);
    svc = await r.json();
  } catch (e) {
    bail(`Cannot reach marketplace: ${e.message}`, 3);
  }

  const ep = svc.endpoint;
  const url = new URL(ep);
  url.searchParams.set(probe ? 'probe' : 'wallet', probe ? '1' : wallet);

  // A wallet's own 5 trials (no registration) are only reachable with a signed call. The signed
  // message uses the catalog id (x402-time), not the URL slug (time) — signing the slug fails
  // with exactly the 402 a bad signature produces, so print the id-correct message rather than
  // letting the caller guess it.
  const trialHeaders = {};
  const signature = flag('signature');
  if (!probe && wallet && wallet !== true) {
    const ts = flag('timestamp') && flag('timestamp') !== true
      ? String(flag('timestamp'))
      : String(Math.floor(Date.now() / 1000));
    if (signature && signature !== true) {
      trialHeaders['X-Wallet-Signature'] = signature;
      trialHeaders['X-Trial-Timestamp'] = ts;
    } else {
      console.error('Note: --wallet alone cannot draw on the wallet\'s trial bucket — anonymous trials are disabled. To use the wallet\'s own 5 trials, sign');
      console.error('this exact message (EIP-191 personal_sign):\n');
      console.error(`  minia2a trial:${wallet}:${svc.id}:${ts}\n`);
      console.error('then rerun within 5 minutes:\n');
      console.error(`  minia2a call ${id} --wallet ${wallet} --timestamp ${ts} --signature 0xYOUR_SIGNATURE\n`);
      console.error(`(cast example: cast wallet sign "minia2a trial:${wallet}:${svc.id}:${ts}")\n`);
    }
  }

  try {
    const opts = { headers: apiHeaders(url.toString(), { 'User-Agent': 'minia2a-skill/1.x', ...trialHeaders }) };
    let r;
    if (input !== undefined) {
      opts.method = 'POST';
      opts.headers['Content-Type'] = 'application/json';
      opts.body = JSON.stringify(input);
      r = await fetch(url.toString(), opts);
    } else {
      r = await fetch(url.toString(), opts);
    }

    const d = await r.json();

    if (r.status === 402) {
      // Payment required — surface the machine-readable x402 payload.
      console.error(`Payment required (HTTP 402) for ${svc.name}. Price: $${svc.price} USDC.`);
      if (trialHeaders['X-Wallet-Signature']) {
        console.error(`Signed as ${wallet}: either this wallet's 5 trials are spent, or the`);
        console.error('signature is invalid, or the timestamp is older than 5 minutes.');
      }
      console.error('x402 accepts[]:');
      json(d);
      process.exit(3);
    }

    // Which bucket paid for the call — "wallet" means the signature was accepted.
    const mode = r.headers.get('x-trial-mode');
    if (mode) console.error(`trial: mode=${mode} remaining=${r.headers.get('x-trial-remaining') ?? '?'}`);

    json(d);
    if (!r.ok) process.exit(3);
  } catch (e) {
    bail(`Call failed: ${e.message}`, 3);
  }
}

async function help() {
  const topic = positional[0];
  if (topic) {
    console.error(`minia2a help: ${topic}\n`);
    console.error('The full machine-readable guide lives at https://minia2a.uk/AGENTS.md');
    console.error('Quick reference:');
    console.error('  register — POST /api/v1/register-simple {name, wallet, signature} → prove wallet ownership (for publishing)');
    console.error('  publish  — POST /api/v1/publish-service {name, endpoint, price_cents, category, wallet, signature} (SELLER side)');
    console.error('  call     — GET <service-endpoint>?wallet=0x... + signed trial headers (5 free trials per wallet)');
    console.error('  probe    — append ?probe=1 to any endpoint → HTTP 402 with payment JSON (free)');
    return;
  }
  console.error(USAGE.trim());
}

// ----- main -----
(async () => {
  try {
    switch (cmd) {
      case 'discover':
      case 'search':
      case 'list':
        return await discover();
      case 'meta':
      case 'info':
      case 'stats':
        return await meta();
      case 'publish':
      case 'sell':
        return await publish();
      case 'register':
      case 'reg':
        return await register();
      case 'call':
        return await call(positional[0]);
      case 'help':
      case '--help':
      case '-h':
        return await help();
      default:
        bail(`Unknown command: ${cmd}\n${USAGE}`);
    }
  } catch (e) {
    bail(`Unexpected error: ${e.message}`, 3);
  }
})();
